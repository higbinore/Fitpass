# FitPass environment variables
# Copy this file to .env.local and fill in real values locally.
# Never commit .env.local and never paste secret values into chat or logs.
#
# On Vercel, set the same names under Project Settings > Environment Variables.

# Neon Postgres connection string (use the pooled connection string)
DATABASE_URL=

# Better Auth
# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Local: http://localhost:3000 — deployed: your production URL
BETTER_AUTH_URL=

# Paystack — TEST MODE ONLY. The key must start with sk_test_
PAYSTACK_SECRET_KEY=

# Resend (transactional email, used for renewal reminders)
RESEND_API_KEY=
# Example: FitPass <membership@your-verified-domain.com>
EMAIL_FROM=

# Shared secret for the daily reminder cron endpoint (/api/cron/reminders)
CRON_SECRET=
FITPASS_INITIAL_GYM_SLUG=

# Vercel Blob persistent public storage for gym logos and facility photos
BLOB_READ_WRITE_TOKEN=

# Optional map provider key; configure provider-restricted public key in Vercel
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Payment mode: paystack (TEST keys only) or demo (no real charges)
FITPASS_PAYMENT_MODE=paystack
